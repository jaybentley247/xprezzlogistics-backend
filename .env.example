# Port the API listens on (the frontend defaults to http://localhost:5000)
PORT=5000

# Admin dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Long random string used to sign admin login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Optional: comma-separated list of allowed frontend origins (blank = allow all)
CORS_ORIGIN=

# Postgres connection string (e.g. from your Neon project's Connect dialog)
DATABASE_URL=

# Optional: email the recipient when their shipment is updated (https://resend.com)
RESEND_API_KEY=
# Sender address. Must use a domain verified in Resend, e.g.
# Xprezz Logistics <updates@xprezzlogistics.com>
# (For testing, onboarding@resend.dev only delivers to your own Resend account email.)
EMAIL_FROM=
# Public address of the website, used for the "Track your shipment" link in emails
SITE_URL=
